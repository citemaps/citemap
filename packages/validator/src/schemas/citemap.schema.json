{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citemaps.org/schema/v3.5/citemap.schema.json",
  "title": "citemap.json v3.5",
  "description": "JSON Schema for citemap.json v3.5 (https://citemaps.org/spec/). Types the fields the spec defines and stays open to others (additionalProperties true). Rules the schema can't express (reachability, @id uniqueness across content files, products in content files, the citemap level) are checked by @citemap/validator per spec \u00a713.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "@type",
    "version",
    "citationContract",
    "brand",
    "lastVerified",
    "answerContent",
    "temporalRecord",
    "policy",
    "verification"
  ],
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://citemaps.org/v3.5"
    },
    "@type": {
      "const": "Citemap"
    },
    "version": {
      "type": "string",
      "const": "3.5"
    },
    "citemapVersion": {
      "type": "string",
      "const": "3.5"
    },
    "$schema": {
      "type": "string"
    },
    "generatedBy": {
      "type": "string"
    },
    "citationContract": {
      "$ref": "#/$defs/citationContract"
    },
    "brand": {
      "type": "object",
      "properties": {
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "@id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "siteType": {
          "type": "string"
        },
        "legalName": {
          "type": "string"
        },
        "alternateName": {
          "type": "string"
        },
        "shortName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "aiSummary": {
          "type": "string"
        },
        "notableFor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "expertise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audiencePrimary": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "founded": {
          "type": [
            "string",
            "integer"
          ]
        },
        "areaServed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numberOfEmployees": {
          "enum": [
            "1-10",
            "11-50",
            "51-200",
            "201-500",
            "501-1000",
            "1001-5000",
            "5000+"
          ]
        },
        "mission": {
          "type": "string"
        },
        "diversityOwnership": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languagesSupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guarantees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "sameAs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "team": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/teamMember"
          }
        },
        "teamPageUrl": {
          "type": "string"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "disambiguatingDescription": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/distinctFrom"
          }
        },
        "productCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "serviceCategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "storefronts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storefront"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "subBrands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subBrand"
          }
        },
        "publications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publication"
          }
        },
        "corroboratedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/corroboration"
          }
        },
        "subjectOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectOfEntry"
          },
          "maxItems": 10
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/video"
          }
        },
        "podcasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/podcast"
          }
        },
        "speaking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speaking"
          }
        },
        "businessRelationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/businessRelationship"
          }
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "publishingPrinciples": {
          "type": "string"
        },
        "correctionsPolicy": {
          "type": "string"
        },
        "employee": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/idRef"
          }
        },
        "memberOf": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "name",
        "url",
        "sameAs",
        "team"
      ],
      "description": "The entity. v3.0, v3.3 \u00a74, v3.5 \u00a74\u2013\u00a77."
    },
    "contentFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentFileRef"
      }
    },
    "lastVerified": {
      "$ref": "#/$defs/date"
    },
    "answerContent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/answer"
      }
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "temporalRecord": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporalEvent"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "@graph": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "verifiedClaims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verifiedClaim"
      }
    },
    "citemapLevel": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "citemap": {
      "$ref": "#/$defs/citemapBlock"
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "Absolute http(s) URL."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD (a time may follow)."
    },
    "idRef": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "@id"
      ]
    },
    "subjectOfEntry": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "name": {
          "type": "string"
        },
        "datePublished": {
          "$ref": "#/$defs/date"
        },
        "publisher": {
          "type": "object",
          "properties": {
            "@type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "@type": {
                "type": "string"
              },
              "@id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "url"
      ],
      "description": "v3.5 \u00a77.2: a third-party page about the subject (schema.org CreativeWork form)."
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "discontinued"
          ]
        },
        "endDate": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "description": "v3.5 \u00a75.4"
    },
    "priceRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "connection": {
      "type": "object",
      "properties": {
        "edge": {
          "enum": [
            "about",
            "creator",
            "featuring",
            "publishedOn",
            "recordedIn"
          ]
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetName": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "edge",
        "targetType"
      ],
      "description": "v3.5 \u00a76.1"
    },
    "mediaRole": {
      "enum": [
        "authored",
        "featured",
        "mentioned"
      ]
    },
    "citationContract": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "$ref": "#/$defs/date"
        },
        "updateFrequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annually",
            "rarely"
          ]
        },
        "canonicalSource": {
          "$ref": "#/$defs/url"
        },
        "contactForCorrections": {
          "type": "string"
        },
        "registryToken": {
          "type": "string"
        },
        "disambiguation": {
          "type": "string"
        },
        "preferredName": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "description": "v3.5 \u00a71.2"
    },
    "citemapBlock": {
      "type": "object",
      "properties": {
        "authorizedBy": {
          "type": "string"
        },
        "contactForDisputes": {
          "type": "string"
        },
        "generationId": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "description": "v3.5 \u00a71.3"
    },
    "trust": {
      "type": "object",
      "properties": {
        "computedAt": {
          "type": "string",
          "format": "date-time"
        },
        "perField": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "enum": [
                  "T1",
                  "T2",
                  "T3",
                  "T4",
                  "T5",
                  "T6"
                ]
              },
              {
                "type": "object",
                "description": "v3.3 sketch form (deprecated)"
              }
            ]
          }
        }
      },
      "additionalProperties": true,
      "description": "v3.5 \u00a72.2"
    },
    "temporalEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedTeamMemberId": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "date",
        "label"
      ],
      "description": "v3.5 \u00a72.3"
    },
    "policyEntry": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "summary": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "properties": {
        "editorial": {
          "$ref": "#/$defs/policyEntry"
        },
        "correction": {
          "$ref": "#/$defs/policyEntry"
        },
        "disclosure": {
          "$ref": "#/$defs/policyEntry"
        },
        "privacy": {
          "$ref": "#/$defs/policyEntry"
        },
        "lastUpdated": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": true,
      "description": "v3.3 \u00a73.2, v3.5 \u00a72.4"
    },
    "answer": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "question",
        "answer"
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "issuedDate": {
          "$ref": "#/$defs/date"
        },
        "expiresAt": {
          "$ref": "#/$defs/date"
        },
        "verifierUrl": {
          "$ref": "#/$defs/url"
        },
        "evidence": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "certification",
            "license",
            "accreditation",
            "membership",
            "award",
            "other"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "claim",
        "issuer"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "lastUpdated": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": true,
      "required": [
        "claims"
      ],
      "description": "v3.3 \u00a73.2, v3.5 \u00a72.6"
    },
    "verifiedClaim": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "registryUrl": {
          "$ref": "#/$defs/url"
        },
        "claimType": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "description": "v3.0 \u00a75 / v3.5 \u00a72.7. type + identifier required (checked by the validator so legacy claimType rows only warn)."
    },
    "node": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string"
        },
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "@id"
      ]
    },
    "relationship": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "observedAt": {
          "$ref": "#/$defs/date"
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "from",
        "to",
        "type"
      ]
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "taxonomyVersion": {
          "type": "string"
        },
        "primaryVertical": {
          "type": "string"
        },
        "additionalVerticals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entityType": {
          "type": "string"
        },
        "organizationType": {
          "type": "string"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "distinctFrom": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "reason": {
          "enum": [
            "same-name-different-location",
            "similar-name",
            "former-affiliate",
            "imposter",
            "unrelated"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "description": "v3.5 \u00a74.3"
    },
    "teamMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "jobTitle": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "photoUrl": {
          "type": "string"
        },
        "sameAs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "honorificPrefix": {
          "type": "string"
        },
        "honorificSuffix": {
          "type": "string"
        },
        "formerlySince": {
          "type": [
            "string",
            "null"
          ]
        },
        "formerlyReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "description": "v3.3 \u00a74.5"
    },
    "variant": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object"
        },
        "sku": {
          "type": "string"
        },
        "gtin": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "priceRange": {
          "$ref": "#/$defs/priceRange"
        }
      },
      "additionalProperties": true,
      "required": [
        "attributes"
      ]
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "gtin": {
          "type": "string"
        },
        "productType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "pageUrl": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "specifications": {
          "type": [
            "string",
            "object"
          ]
        },
        "priceRange": {
          "$ref": "#/$defs/priceRange"
        },
        "categoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object"
        },
        "variesBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      },
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "description": "v3.3 \u00a74.7, v3.5 \u00a75.1"
    },
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "serviceType": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pageUrl": {
          "type": "string"
        },
        "categoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
